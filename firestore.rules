rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only Moses and Adunni can read or write the trip plan.
    // Replace the two emails with the ones you sign in with in the app.
    match /trips/{tripId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['YOUR-EMAIL@example.com', 'ADUNNI-EMAIL@example.com'];
    }
  }
}
