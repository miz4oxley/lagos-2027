rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WellPlanned: only the two trip planners can read or write.
    match /trips/{tripId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email.lower() in ['moses.akinde@gmail.com', 'motunrayoolaide@yahoo.com'];
    }
  }
}
